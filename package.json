{
  "name": "mcp-projector",
  "version": "0.3.0",
  "description": "Bolt a live, styled human UI onto any MCP server. No framework.",
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "example": "cd examples/notes-server && npm install && npm run build",
    "test": "npm run build && npm run example && npm run test:snapshot && vitest run --project unit",
    "test:snapshot": "node tests/agent-snapshot.mjs examples/notes-server/dist/server.js open_notes_in_browser | diff - tests/baseline.json && echo \"PASS agent-facing tools and results match the baseline\"",
    "test:web": "vitest run --project web",
    "test:workers": "npm run build && cd examples/cloudflare-worker && npm install && cd ../.. && vitest run --project workers",
    "test:watch": "vitest --project unit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "ui",
    "server-rendered",
    "live"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "skills",
    "docs/*.md"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "mcp-projector": "bin/mcp-projector.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/jarrod/projector.git"
  }
}
