{
  "name": "mcp-projector",
  "version": "0.3.0",
  "description": "Bolt a live, styled human UI onto any MCP server. No framework.",
  "scripts": {
    "build": "node scripts/build.ts",
    "prepare": "node scripts/build.ts",
    "typecheck": "tsc -p tests && tsc -p examples/notes-server --noEmit",
    "test": "pnpm build && pnpm typecheck && vitest run --project unit",
    "test:web": "pnpm build && pnpm -F notes-server-example build && vitest run --project web",
    "test:workers": "pnpm build && vitest run --project workers",
    "test:watch": "vitest --project unit",
    "dev": "pnpm build && pnpm -F notes-server-example build && node scripts/dev.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "ui",
    "server-rendered",
    "live"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "skills",
    "docs/*.md"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@modelcontextprotocol/server": "^2.4.0",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "mcp-projector": "bin/mcp-projector.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/jarrod/projector.git"
  },
  "packageManager": "pnpm@10.15.1"
}
