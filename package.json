{
  "name": "mcp-projector",
  "version": "0.3.0",
  "description": "Bolt a live, styled human UI onto any MCP server. No framework.",
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "example": "cd examples/notes-server && npm install && npm run build",
    "test": "npm run build && npm run example && cd tests && npm install && npm run snapshot && npm run unit && npm run host",
    "test:web": "cd tests && npm run web"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-apps",
    "ui",
    "server-rendered",
    "live"
  ],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "bin",
    "AGENTS.md",
    "CHANGELOG.md",
    "README.md",
    "skills",
    "docs/*.md"
  ],
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^26.6.6",
    "esbuild": "^0.24.2",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "bin": {
    "mcp-projector": "bin/mcp-projector.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/jarrod/projector.git"
  }
}
