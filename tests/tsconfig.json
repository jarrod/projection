{
  // Type-checks the tests and scripts against the built package's types (run `pnpm build` first). Nothing is emitted.
  // Implicit any is allowed: tests pass loosely shaped fixtures around, and what matters is the library's API.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts", "../scripts/*.ts", "../vitest.config.ts"]
}
